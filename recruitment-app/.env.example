# Copy this to `.env` and fill in your values.
# Team key for the iHQ LiteLLM proxy (see litellm-api-keys.xlsx) - not a
# direct Anthropic key. $3 lifetime budget per key; check spend with:
#   curl "https://litellm.i-hq.tech/key/info" -H "Authorization: Bearer sk-<your-key>"
LITELLM_API_KEY=sk-...

# Google Drive folders (open the folder in Drive, copy the id from the URL:
# https://drive.google.com/drive/folders/<this-part>).
GOOGLE_DRIVE_RESUMES_FOLDER_ID=
GOOGLE_DRIVE_JD_FOLDER_ID=

# Google Calendar to check availability on / book interviews into.
# "primary" works if you only have one calendar.
GOOGLE_CALENDAR_ID=primary

# Who to check availability for and invite, comma-separated.
INTERVIEWER_EMAILS=interviewer1@example.com,interviewer2@example.com

# Google OAuth needs `credentials.json` (downloaded from Google Cloud Console,
# see README) sitting next to this file. Never commit it, or the `token.json`
# it produces after the first login.
